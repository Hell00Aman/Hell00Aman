import json, os, urllib.request
from datetime import datetime, timezone

USER = os.environ.get("GH_USER", "Hell00Aman")
TOKEN = os.environ.get("GITHUB_TOKEN", "")


def api(path):
    req = urllib.request.Request(
        "https://api.github.com" + path,
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": "Bearer " + TOKEN,
            "User-Agent": "trophy-cabinet",
        },
    )
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def safe(fn, default=0):
    try:
        return fn()
    except Exception as e:
        print("warning:", e)
        return default


def collect():
    user = api(f"/users/{USER}")
    repos, page = [], 1
    while page <= 5:
        chunk = api(f"/users/{USER}/repos?per_page=100&type=owner&page={page}")
        repos += chunk
        if len(chunk) < 100:
            break
        page += 1
    own = [r for r in repos if not r.get("fork")]
    created = datetime.fromisoformat(user["created_at"].replace("Z", "+00:00"))
    years = (datetime.now(timezone.utc) - created).days / 365.25
    return {
        "Stars": sum(r["stargazers_count"] for r in own),
        "Commits": safe(lambda: api(f"/search/commits?q=author:{USER}&per_page=1")["total_count"]),
        "Followers": user["followers"],
        "Repos": user["public_repos"],
        "Pull Requests": safe(lambda: api(f"/search/issues?q=author:{USER}+type:pr&per_page=1")["total_count"]),
        "Languages": len({r["language"] for r in own if r.get("language")}),
        "Years": round(years, 1),
    }


# thresholds for ranks C, B, A, S
LIMITS = {
    "Stars": (1, 10, 50, 200),
    "Commits": (10, 100, 500, 2000),
    "Followers": (1, 10, 50, 200),
    "Repos": (1, 10, 30, 80),
    "Pull Requests": (1, 10, 50, 200),
    "Languages": (1, 3, 5, 8),
    "Years": (0.1, 1, 3, 6),
}
COLORS = {"S": "#ffbe0b", "A": "#ff006e", "B": "#8338ec", "C": "#3a86ff", "-": "#555555"}


def rank(name, value):
    c, b, a, s = LIMITS[name]
    if value >= s: return "S"
    if value >= a: return "A"
    if value >= b: return "B"
    if value >= c: return "C"
    return "-"


def build_svg(stats):
    w, n = 130, len(stats)
    out = [
        f'<svg xmlns="http://www.w3.org/2000/svg" width="{w*n}" height="190" viewBox="0 0 {w*n} 190" font-family="Segoe UI, Arial, sans-serif">',
        f'<rect width="{w*n}" height="190" rx="12" fill="#0d0d0d"/>',
    ]
    for i, (name, val) in enumerate(stats.items()):
        r = rank(name, val)
        col = COLORS[r]
        cx = i * w + w / 2
        shown = f"{val:g}" if isinstance(val, float) else str(val)
        out.append(
            f'<g transform="translate({cx-20},22)" fill="{col}" stroke="{col}" stroke-width="2">'
            '<path d="M10 4h20v10c0 8-4 13-10 14c-6-1-10-6-10-14z" stroke="none"/>'
            '<path d="M10 8H4c0 6 3 10 7 11M30 8h6c0 6-3 10-7 11" fill="none"/>'
            '<rect x="18" y="28" width="4" height="7" stroke="none"/>'
            '<rect x="12" y="35" width="16" height="4" rx="1" stroke="none"/></g>'
        )
        out.append(f'<text x="{cx}" y="92" text-anchor="middle" font-size="22" font-weight="700" fill="{col}">{r}</text>')
        out.append(f'<text x="{cx}" y="125" text-anchor="middle" font-size="22" font-weight="700" fill="#ffffff">{shown}</text>')
        out.append(f'<text x="{cx}" y="150" text-anchor="middle" font-size="13" fill="#b0b0b0">{name}</text>')
    out.append("</svg>")
    return "\n".join(out)


if __name__ == "__main__":
    svg = build_svg(collect())
    with open("github-trophies.svg", "w", encoding="utf-8") as f:
        f.write(svg)
    print("github-trophies.svg written")
